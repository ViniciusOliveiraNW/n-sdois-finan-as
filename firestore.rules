rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCoupleMember(coupleId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    // Ping / connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Users Collection (Isolated PII)
    match /users/{userId} {
      allow get: if true;
      allow create: if isUser(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if true;
    }

    // Couples Collection
    match /couples/{coupleId} {
      allow get, list: if true;
      allow create: if isSignedIn() && (
        request.resource.data.partner1Uid == request.auth.uid ||
        request.resource.data.createdBy == request.auth.uid
      );
      allow update: if true;
      allow delete: if isSignedIn() && (
        resource.data.partner1Uid == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        (resource.data.partner1Email != null && resource.data.partner1Email == request.auth.token.email)
      );
    }

    // Purchases Subcollection
    match /couples/{coupleId}/purchases/{purchaseId} {
      allow read, write: if true;
    }

    // Closures Subcollection
    match /couples/{coupleId}/closures/{closureId} {
      allow read, write: if true;
    }

    // Temporary pairing codes for Telegram bot
    match /telegram_codes/{codeId} {
      allow read, write: if true;
    }

    // Direct mapping of Telegram User ID to Couple/User
    match /telegram_users/{userId} {
      allow read, write: if true;
    }

    // Conversational pending operations for Telegram bot
    match /telegram_operations/{operationId} {
      allow read, write: if true;
    }
  }
}
