rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCoupleMember(coupleId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    // Ping / connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Users Collection (Isolated PII)
    match /users/{userId} {
      allow get: if isUser(userId);
      allow create: if isUser(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isUser(userId) && request.resource.data.uid == resource.data.uid;
    }

    // Couples Collection
    match /couples/{coupleId} {
      // Allows members to read, and allows searching by inviteCode for pairing
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.partner1Uid == request.auth.uid;
      // Allows existing members or a new partner affiliating with valid invite
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.members ||
        request.auth.uid in request.resource.data.members
      );
    }

    // Purchases Subcollection
    match /couples/{coupleId}/purchases/{purchaseId} {
      allow read: if isCoupleMember(coupleId);
      // Only members can create, and cadastradoPorUid must match auth uid
      allow create: if isCoupleMember(coupleId) && request.resource.data.cadastradoPorUid == request.auth.uid;
      // Rule of authorship: Only the author can update or delete!
      allow update: if isCoupleMember(coupleId) && resource.data.cadastradoPorUid == request.auth.uid;
      allow delete: if isCoupleMember(coupleId) && resource.data.cadastradoPorUid == request.auth.uid;
    }

    // Closures Subcollection
    match /couples/{coupleId}/closures/{closureId} {
      allow read: if isCoupleMember(coupleId);
      allow create: if isCoupleMember(coupleId) && request.resource.data.conciliadoPorUid == request.auth.uid;
      allow update: if isCoupleMember(coupleId);
      allow delete: if isCoupleMember(coupleId);
    }
  }
}
